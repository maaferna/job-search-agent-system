{
  "permissions": {
    "allow": [
      "Bash(lualatex:*)",
      "Bash(./scripts/build_cv.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Edit(operations/applications/*/sent/**)",
      "Write(operations/applications/*/sent/**)",
      "Read(credentials/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/session_start.sh",
            "timeout": 20,
            "statusMessage": "Syncing the repository and launching today's capture…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "./scripts/guard_bash.sh" }
        ]
      }
    ]
  }
}
